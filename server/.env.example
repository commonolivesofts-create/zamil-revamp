# Copy to .env for local development. Never commit real credentials.

# Runtime environment: development | test | uat | production (required)
NODE_ENV=development

# HTTP listener port
PORT=3000

# Pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of Express (0 = trust none)
TRUST_PROXY_HOPS=0

# Maximum JSON request body size (e.g. 100kb, 1mb)
REQUEST_BODY_LIMIT=100kb

# Deadline for in-flight requests to complete during graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Swagger UI at /api/docs. Permitted only in development and test until the
# documentation access policy is finalized.
API_DOCS_ENABLED=true

# Readiness (/health/ready): per-check deadline and how long a result is reused
HEALTH_READY_TIMEOUT_MS=3000
HEALTH_READY_CACHE_MS=5000

# --- Oracle ADW (node-oracledb Thin mode, wallet mTLS) ---
# Local development uses the TEST database (zpadwtest) only.
ORACLE_USER=
ORACLE_PASSWORD=
# Relative paths resolve against server/. Must contain tnsnames.ora and ewallet.pem.
ORACLE_WALLET_DIR=../secrets/oracle/Wallet_zpadwtest
# Password protecting ewallet.pem (not the database user password)
ORACLE_WALLET_PASSWORD=
# Service aliases from the wallet's tnsnames.ora
ORACLE_LOW_ALIAS=zpadwtest_low
ORACLE_HIGH_ALIAS=zpadwtest_high
ORACLE_CONNECT_TIMEOUT_S=15
ORACLE_STMT_CACHE_SIZE=30
ORACLE_POOL_STATISTICS=true

# LOW: ordinary APIs, CRUD, transactions, authentication (conservative development sizes)
ORACLE_LOW_POOL_MIN=1
ORACLE_LOW_POOL_MAX=4
ORACLE_LOW_QUEUE_MAX=50
ORACLE_LOW_QUEUE_TIMEOUT_MS=10000

# HIGH: approved complex reports and analytics only
ORACLE_HIGH_POOL_MIN=0
ORACLE_HIGH_POOL_MAX=2
ORACLE_HIGH_QUEUE_MAX=10
ORACLE_HIGH_QUEUE_TIMEOUT_MS=30000
