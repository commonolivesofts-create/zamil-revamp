# Zamil Attendance System — environment settings.
# Copy to `.env` (git-ignored) and fill in the values. Never commit `.env`.
# Real environment variables (Apache SetEnv / OS) override this file.

# --- CodeIgniter -----------------------------------------------------------
# development | testing | production
CI_ENV=development
# 0 = off, 1 = errors, 2 = debug, 3 = info, 4 = all (writes application/logs)
CI_LOG_THRESHOLD=1
# 32+ random characters, e.g. php -r "echo bin2hex(random_bytes(32));"
CI_ENCRYPTION_KEY=
# Attendance session cookie (kept distinct from the old CI3 app's ci_session)
CI_SESS_COOKIE_NAME=zatt_session

# --- Oracle ADW (default DB, schema XXZP) ----------------------------------
# Local/dev: the Zamil Revamp TEST ADW — never the production ADW.
# Wallet path may be relative to this project root. Requires PHP oci8 +
# Oracle Instant Client (see README_LOCAL_SETUP.md).
ADW_WALLET_DIR=../secrets/oracle/Wallet_zpadwtest
# Use the _tp (transaction processing) service: _high enables parallel DML,
# which raises ORA-12838 when a transaction reads a table after writing it
# (attendance upload, shift-detail save).
ADW_TNS_ALIAS=zpadwtest_tp
ADW_USERNAME=XXZP
ADW_PASSWORD=
ADW_PCONNECT=true

# --- Oracle E-Business Suite (ebs DB) --------------------------------------
# Biometric punches (ZPI.ICLOCK_TRANSACTION ...) and contractor master data.
# Reachable only from the Zamil network/VPN. Use a TEST instance and a
# least-privilege account for development, not production APPS.
EBS_DB_HOST=
EBS_DB_PORT=1521
EBS_DB_SID=
EBS_DB_USERNAME=
EBS_DB_PASSWORD=
EBS_DB_CONNECT_TIMEOUT=10

# --- Zamil Digitalization single sign-on -----------------------------------
# Zamil backend (zamil-revamp/server) base path ending in /api/v1.
ZAMIL_AUTH_API_BASE_URL=http://127.0.0.1:7381/api/v1
# Zamil login page users are sent to when they are not signed in.
ZAMIL_LOGIN_URL=http://localhost:7382/login
# zr_session when the Zamil server runs with APP_ENV=test, __Host-zr_session
# in plain local development. Both are always tried; this one first.
ZAMIL_AUTH_SESSION_COOKIE_NAME=zr_session
# Re-validate the Zamil session this often (seconds).
ZAMIL_SSO_RECHECK_SECONDS=60
ZAMIL_SSO_TIMEOUT_SECONDS=5
