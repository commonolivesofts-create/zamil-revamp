# TrainingHub — copy to .env (npm run dev does this for you on first start).
# Never put real secrets anywhere except .env and secrets/.

NODE_ENV=development
APP_ENV=development
API_PORT=7383
WEB_PORT=7384
APP_BASE_URL=http://localhost:7384
SESSION_SECRET=change-me-to-a-long-random-string-of-48-chars
TZ=Asia/Riyadh
LOG_LEVEL=info

# memory = local JSON file with demo data; oracle = ADW (run db:migrate + db:seed first)
DATA_MODE=memory
DATA_FILE=./storage/dev-data.json
# DB_USER=
# DB_PASSWORD=
# DB_CONNECT_STRING=
# DB_WALLET_DIR=./secrets/wallet
# DB_WALLET_PASSWORD=
# DB_OBJECT_PREFIX=TH_

# mock = demo employees; live = Fusion HCM via BIP (employees only)
FUSION_MODE=mock
# FUSION_BASE_URL=
# FUSION_USER=
# FUSION_PASSWORD=
# FUSION_BI_USER=
# FUSION_BI_PASSWORD=
FUSION_EMPLOYEE_REPORT=/Custom/TrainingHub/TH_HCM_EMPLOYEES.xdo
FUSION_EMPLOYEE_REPORT_FALLBACK=/Custom/ExpenseHub/EH_HCM_EMPLOYEES.xdo
FUSION_SYNC_HOUR=2
# BOOTSTRAP_ADMINS=

AUTH_PROVIDER=local
DEV_QUICK_LOGIN=true
# INITIAL_PASSWORD=
