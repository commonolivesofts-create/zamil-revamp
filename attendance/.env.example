# Attendance (React + Node.js). Copy to .env (git-ignored); `npm run dev` creates it on first
# run with a random SESSION_SECRET and, when ../server/.env exists, the test-ADW credentials.
# Never commit .env.

NODE_ENV=development
# development | test (test = LAN profile: API and web listen on 0.0.0.0)
APP_ENV=development
API_PORT=7387
WEB_PORT=7388
# 32+ random characters; signs the at_session cookie
SESSION_SECRET=
LOG_LEVEL=info
TZ=Asia/Riyadh

# --- Oracle ADW (schema XXZP, the same tables as zamil-attendance) -----------
# Test ADW only. Use the _tp service: _high enables parallel DML (ORA-12838).
ADW_USER=XXZP
ADW_PASSWORD=
ADW_CONNECT_STRING=zpadwtest_tp
# Relative to this folder. Must contain tnsnames.ora and ewallet.pem.
ADW_WALLET_DIR=../secrets/oracle/Wallet_zpadwtest
# Password protecting ewallet.pem (not the database password)
ADW_WALLET_PASSWORD=
ADW_POOL_MIN=0
ADW_POOL_MAX=8

# --- Oracle E-Business Suite (Phases 7-8) -----------------------------------
# Off until a test EBS instance and a least-privilege account exist.
EBS_ENABLED=false
EBS_USER=
EBS_PASSWORD=
# Full connect descriptor, e.g. (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=..)(PORT=1521))(CONNECT_DATA=(SID=..)))
EBS_CONNECT_STRING=

# --- Zamil Digitalization single sign-on ------------------------------------
ZAMIL_AUTH_API_BASE_URL=http://127.0.0.1:7381/api/v1
# zr_session when the Zamil server runs with APP_ENV=test, __Host-zr_session otherwise
ZAMIL_AUTH_SESSION_COOKIE_NAME=zr_session
ZAMIL_AUTH_COOKIE_SECURE=false
ZAMIL_AUTH_COOKIE_SAMESITE=lax
# Zamil login page for separate-origin deployments (blank: local dev maps port 7388 to 7382)
VITE_ZAMIL_LOGIN_URL=
