# Public client-side project metadata.
# Any VITE_ variable can become visible in the browser build.
# Never put API secrets, passwords, or private keys here.
VITE_APP_NAME=Zamil Revamp

# Phase 09 API boundary: leave empty while server/ is absent.
# Once your backend exists, set its PUBLIC HTTPS origin and optional API prefix
# (e.g. https://your-backend.example/api/v1) or a same-origin /api/v1 path.
# With a different origin, configure CORS and cookies on the backend.

# Phase 06: provide the actual authentication backend contract later.
# Leave empty until endpoints exist. Never use credentials/tokens as VITE_ values.
VITE_API_BASE_URL=
VITE_AUTH_SESSION_PATH=
VITE_AUTH_LOGIN_PATH=
VITE_AUTH_LOGOUT_PATH=
VITE_AUTH_RECOVERY_PATH=

# Optional development-only template preview, never honored by production builds.
# Set true in client/.env.local ONLY when you intentionally want the dashboard
# accessible for frontend layout work without a server. This is not login.
VITE_AUTH_DEV_PREVIEW=false
