{
  "name": "zamil-revamp-server",
  "version": "2.1.0",
  "description": "Zamil Digitalization backend API (Express 5 modular monolith)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:status": "node --env-file-if-exists=.env scripts/db-status.js",
    "db:verify-auth": "node --env-file-if-exists=.env scripts/verify-auth-sql.js",
    "db:bootstrap-test": "node --env-file-if-exists=.env scripts/bootstrap-test-rbac.js",
    "db:rbac-register": "node --env-file-if-exists=.env scripts/rbac-register.js",
    "auth:mfa-test": "node --env-file-if-exists=.env scripts/mfa-test-flow.js",
    "auth:rbac-test": "node --env-file-if-exists=.env scripts/rbac-test-flow.js",
    "db:rbac-post-check": "node --env-file-if-exists=.env scripts/rbac-post-check.js",
    "auth:users-test": "node --env-file-if-exists=.env scripts/users-test-flow.js",
    "db:users-check": "node --env-file-if-exists=.env scripts/users-integration-check.js",
    "auth:password-reminders": "node --env-file-if-exists=.env scripts/password-expiry-reminders.js",
    "smtp:verify": "node --env-file-if-exists=.env scripts/smtp-verify.js",
    "auth:setup-test": "node --env-file-if-exists=.env scripts/setup-test-flow.js",
    "db:setup-check": "node --env-file-if-exists=.env scripts/setup-integration-check.js",
    "auth:rbac-user-test": "node --env-file-if-exists=.env scripts/rbac-user-test-flow.js",
    "auth:recovery-test": "node --env-file-if-exists=.env scripts/recovery-test-flow.js",
    "db:phase06-check": "node --env-file-if-exists=.env scripts/phase06-check.js",
    "test": "node --import ./tests/setup.js --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.7",
    "oracledb": "^26.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
