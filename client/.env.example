# Public client-side project metadata.
# Any VITE_ variable can become visible in the browser build.
# Never put API secrets, passwords, or private keys here.
VITE_APP_NAME=Zamil Revamp

# API base. Leave empty for the default same-origin /api/v1 path: in development
# the Vite proxy forwards /api to the backend on http://localhost:3000; deployed,
# a gateway or reverse proxy must serve the frontend and /api on one origin.
# The backend has no CORS support and its session cookie is SameSite=Lax, so a
# cross-origin API base is not supported. Authentication endpoint paths are
# fixed by the backend contract. Never use credentials/tokens as VITE_ values.
VITE_API_BASE_URL=

# Optional development-only template preview, never honored by production builds.
# Set true in client/.env.local ONLY for isolated layout work: the backend is not
# contacted, sign-in is disabled and nothing is authenticated. This is not login.
VITE_AUTH_DEV_PREVIEW=false
