# ExpenseHub — copy to .env (npm run dev does this for you on first start).
# Never put real secrets anywhere except .env and secrets/.

NODE_ENV=development
APP_ENV=development
API_PORT=7385
WEB_PORT=7386
APP_BASE_URL=http://localhost:7386
SESSION_SECRET=change-me-64-chars
TZ=Asia/Riyadh
LOG_LEVEL=info

DATA_MODE=memory                        # memory | oracle (oracle from M8, D-33)
DATA_FILE=./storage/dev-data.json

# Required only when DATA_MODE=oracle (M8)
# DB_USER=EXPENSEHUB
# DB_PASSWORD=
# DB_CONNECT_STRING=expensehub_low      # TNS alias from the ADW wallet
# DB_WALLET_DIR=../secrets/oracle/Wallet_zpadwtest
# DB_WALLET_PASSWORD=
# DB_POOL_MIN=1
# DB_POOL_MAX=5

FUSION_MODE=mock                        # mock | live — live: real employees/accounts from Fusion (D-50)
# BOOTSTRAP_ADMINS=                     # person numbers made System Admin on the first live start
# FUSION_BI_USER= / FUSION_BI_PASSWORD= # BI author account for npm run fusion:bip-deploy (D-44)
# Required only when FUSION_MODE=live
# FUSION_BASE_URL=https://iaeskf-test.fa.ocs.oraclecloud.com   # test pod (OQ-21)
# FUSION_USER=
# FUSION_PASSWORD=
FUSION_REST_VERSION=11.13.18.05
FUSION_BIP_PATH_PREFIX=/Custom/ExpenseHub
FUSION_POD_URL=https://iaeskf-test.fa.ocs.oraclecloud.com   # "Open in Fusion test pod" links (D-36)
FUSION_MOCK_STATE=./storage/mock-fusion.json                 # mock invoices (dev simulator, D-36)

RECEIPTS_DIR=./storage/receipts
MAX_UPLOAD_MB=10
OCR_PROVIDER=tesseract                  # tesseract | none
NOTIFY_TRANSPORT=outbox                 # outbox (dev Mail page + console) | smtp (go-live, OQ-25)
# Required only when NOTIFY_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=ExpenseHub <expensehub@zamilplastic.com>
TEAMS_WEBHOOK_URL=
AUTH_PROVIDER=local                     # local | entra
DEV_QUICK_LOGIN=true                    # ignored (always off) when NODE_ENV=production
