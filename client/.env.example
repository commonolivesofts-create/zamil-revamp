# Public client-side configuration only. Every VITE_ variable is compiled into
# the browser bundle: never put API secrets, passwords, tokens or keys here.
VITE_APP_NAME=Zamil Digitalization

# API base. Leave empty for the default same-origin /api/v1 path.
# - Development: the Vite server (http://localhost:5199, see vite.config.js)
#   proxies /api to the backend on http://localhost:3000, so the browser only
#   talks to one origin.
# - Deployed: a gateway, reverse proxy or hosting rewrite must serve this
#   frontend and /api on the same origin (see README.md).
# The backend has no CORS support and its session cookie is a SameSite=Lax
# __Host- cookie, so a cross-origin API base is not supported. Endpoint paths
# are fixed by the backend contract and are not configurable.
VITE_API_BASE_URL=

# Development-only layout preview, never honored by production builds. When
# true, the backend is not contacted, sign-in is disabled and nothing is
# authenticated. Keep false for any real (Oracle TEST) integration.
VITE_AUTH_DEV_PREVIEW=false

# Backend settings that must match this frontend (server/.env, not this file):
#   AUTH_FRONTEND_BASE_URL=http://localhost:5199   e-mailed setup/recovery links
#   AUTH_PASSWORD_SETUP_PATH=/password/setup
#   AUTH_PASSWORD_RESET_PATH=/password/reset
#   AUTH_MFA_RECOVERY_PATH=/mfa/recovery
# Through the same-origin proxy no AUTH_ALLOWED_ORIGINS entry is needed.
