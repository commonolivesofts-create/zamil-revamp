# Copy to .env for local development. Never commit real credentials.

# Runtime environment: development | test | uat | production (required)
NODE_ENV=development

# Shared app profile: development (local), Test (LAN test at 10.10.2.160), or empty (production)
# APP_ENV=development

# HTTP listener port
PORT=3000

# Listener address (default 127.0.0.1 in development/test, 0.0.0.0 otherwise)
HTTP_HOST=127.0.0.1

# Pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of Express (0 = trust none)
TRUST_PROXY_HOPS=0

# Maximum JSON request body size (e.g. 100kb, 1mb)
REQUEST_BODY_LIMIT=100kb

# Deadline for in-flight requests to complete during graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Swagger UI at /api/docs. Permitted only in development and test until the
# documentation access policy is finalized.
API_DOCS_ENABLED=true

# Readiness (/health/ready): per-check deadline and how long a result is reused
HEALTH_READY_TIMEOUT_MS=3000
HEALTH_READY_CACHE_MS=5000

# --- Oracle ADW (node-oracledb Thin mode, wallet mTLS) ---
# Local development uses the TEST database (zpadwtest) only.
ORACLE_USER=
ORACLE_PASSWORD=
# Relative paths resolve against server/. Must contain tnsnames.ora and ewallet.pem.
ORACLE_WALLET_DIR=../secrets/oracle/Wallet_zpadwtest
# Password protecting ewallet.pem (not the database user password)
ORACLE_WALLET_PASSWORD=
# Service aliases from the wallet's tnsnames.ora
ORACLE_LOW_ALIAS=zpadwtest_low
ORACLE_HIGH_ALIAS=zpadwtest_high
ORACLE_CONNECT_TIMEOUT_S=15
ORACLE_STMT_CACHE_SIZE=30
ORACLE_POOL_STATISTICS=true

# LOW: ordinary APIs, CRUD, transactions, authentication (conservative development sizes)
ORACLE_LOW_POOL_MIN=1
ORACLE_LOW_POOL_MAX=4
ORACLE_LOW_QUEUE_MAX=50
ORACLE_LOW_QUEUE_TIMEOUT_MS=10000

# HIGH: approved complex reports and analytics only
ORACLE_HIGH_POOL_MIN=0
ORACLE_HIGH_POOL_MAX=2
ORACLE_HIGH_QUEUE_MAX=10
ORACLE_HIGH_QUEUE_TIMEOUT_MS=30000

# --- Authentication (all optional; secure defaults shown) ---
# Session cookie. The __Host- prefix requires AUTH_COOKIE_SECURE=true (browsers accept Secure
# cookies on http://localhost). AUTH_COOKIE_SECURE=false is refused outside development/test.
AUTH_SESSION_COOKIE_NAME=__Host-zr_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Comma-separated bare origins (besides the API's own) allowed to send state-changing browser
# requests, e.g. https://app.example. Leave empty for local development: the Vite proxy on
# http://localhost:5199 keeps the API same-origin. Behind a TLS gateway, also set
# TRUST_PROXY_HOPS so the API's own origin is computed with the external scheme and host.
AUTH_ALLOWED_ORIGINS=
# Seconds between LAST_ACTIVITY_AT writes for an active session (idle-timeout precision)
AUTH_SESSION_TOUCH_INTERVAL_S=60
# Per-client-IP login attempts per window (approved: 60 per 60 s), enforced in this process only;
# production needs an additional shared or gateway-level limit
AUTH_LOGIN_RATE_LIMIT_MAX=60
AUTH_LOGIN_RATE_LIMIT_WINDOW_S=60
# Argon2id cost for newly created hashes (minimums: 19456 KiB, 2 passes)
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_PASSES=2
AUTH_ARGON2_PARALLELISM=1

# --- MFA (authenticator-app TOTP) ---
# Base64 of exactly 32 random bytes protecting stored TOTP secrets; keep it outside Oracle and Git.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in UAT/production. If empty, MFA cannot be completed and mandatory-MFA users stay
# blocked (403 MFA_REQUIRED). Changing it makes existing enrolments unreadable (no rotation yet).
AUTH_MFA_ENCRYPTION_KEY=
AUTH_MFA_KEY_ID=k1
# Issuer name shown in authenticator apps for NEW enrolments. Codes are verified from the stored
# secret only, so authenticators enrolled under an earlier name keep working.
AUTH_MFA_ISSUER=Zamil Digitalization
# Mandatory MFA for administrators and other privileged accounts. Keep true.
# false is a LOCAL-DEVELOPMENT-ONLY exception: startup is refused unless NODE_ENV=development,
# HTTP_HOST is loopback (127.0.0.1 or ::1) and TRUST_PROXY_HOPS=0. Administrators then sign in with
# username and password and may use Security Administration within their RBAC permissions; sessions
# are never marked MFA-verified, and switching back to true ends those sessions. Never set false in
# UAT, production or any shared/reachable environment.
AUTH_ADMIN_MFA_REQUIRED=true
# HttpOnly cookie carrying the 5-minute MFA login challenge (must differ from the session cookie)
AUTH_MFA_COOKIE_NAME=__Host-zr_mfa

# --- Account e-mail: Office 365 SMTP (password setup / reset / MFA recovery) ---
# Fixed endpoint: smtp.office365.com:587, STARTTLS required, certificate verification always on.
# Disabled by default: every delivery-dependent flow then fails closed (503 DELIVERY_UNAVAILABLE).
# Keep all values below in the secret store / real .env only; never commit them.
SMTP_ENABLED=false
# OAUTH2 (preferred: Entra ID app, client-credentials, SMTP AUTH XOAUTH2) or PASSWORD (only if the
# tenant still permits basic SMTP AUTH for the mailbox)
SMTP_AUTH_METHOD=OAUTH2
# Licensed or shared mailbox that sends the messages (SMTP AUTH enabled for it)
# SMTP_USER=noreply@your-domain.example
# Optional From address (defaults to SMTP_USER; must be a permitted send-as address) and name
# SMTP_FROM=noreply@your-domain.example
SMTP_FROM_NAME=Zamil Digitalization
# OAUTH2: Entra ID tenant (GUID or domain), application (client) ID and client secret
# SMTP_OAUTH_TENANT_ID=
# SMTP_OAUTH_CLIENT_ID=
# SMTP_OAUTH_CLIENT_SECRET=
# PASSWORD: mailbox password (do not set together with the SMTP_OAUTH_* values)
# SMTP_PASSWORD=
# Non-production only (required there when SMTP is enabled; forbidden in production): every
# ordinary-user message goes to this approved mailbox instead of the employee, and only after the
# connected database's SYS_CONTEXT('USERENV','DB_NAME') equals SMTP_TEST_DATABASE_NAME.
# SMTP_TEST_RECIPIENT_OVERRIDE=shaikh.azim@olivesofts.com
# SMTP_TEST_DATABASE_NAME=<TEST DB_NAME, e.g. from: SELECT SYS_CONTEXT('USERENV','DB_NAME') FROM dual>
# Privileged-account (incl. Super Administrator) recovery e-mail: separate approval required; must
# stay false with a test override (privileged messages are never redirected)
SMTP_PRIVILEGED_DELIVERY_ENABLED=false
# Frontend that receives the token in the URL fragment (https outside development/test).
# Local development: http://localhost:5199 (the Vite dev server; not 127.0.0.1 or another port).
# AUTH_FRONTEND_BASE_URL=https://revamp.your-domain.example
AUTH_PASSWORD_SETUP_PATH=/password/setup
AUTH_PASSWORD_RESET_PATH=/password/reset
AUTH_MFA_RECOVERY_PATH=/mfa/recovery
