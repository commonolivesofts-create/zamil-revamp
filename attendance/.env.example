# Attendance (React + Node.js). Copy to .env (git-ignored); `npm run dev` creates it on first
# run with a random SESSION_SECRET and, when ../server/.env exists, the test-ADW credentials.
# Never commit .env.

NODE_ENV=development
# development | test (test = LAN profile: API and web listen on 0.0.0.0)
APP_ENV=development
API_PORT=7387
WEB_PORT=7388
# 32+ random characters; signs the at_session cookie
SESSION_SECRET=
LOG_LEVEL=info
TZ=Asia/Riyadh

# --- Oracle ADW (schema XXZP, the same tables as zamil-attendance) -----------
# Test ADW only. Use the _tp service: _high enables parallel DML (ORA-12838).
ADW_USER=XXZP
ADW_PASSWORD=
ADW_CONNECT_STRING=zpadwtest_tp
# Relative to this folder. Must contain tnsnames.ora and ewallet.pem.
ADW_WALLET_DIR=../secrets/oracle/Wallet_zpadwtest
# Password protecting ewallet.pem (not the database password)
ADW_WALLET_PASSWORD=
ADW_POOL_MIN=0
ADW_POOL_MAX=8

# --- Oracle Instant Client (thick mode) -------------------------------------
# EBS accounts use an older password type that node-oracledb's built-in driver cannot use
# (NJS-116), so EBS goes through the installed Oracle Instant Client, as CI3's oci8 does.
# Blank: C:/oracle/instantclient_23_0 when that folder exists; otherwise the built-in driver
# (ADW works, EBS pages say to set this key).
ORACLE_CLIENT_LIB_DIR=

# --- Oracle E-Business Suite (Daily Attendance, Manager View, Contractors) -----
# The same keys and values as zamil-attendance/.env. EBS is on the Zamil LAN: connect the VPN
# (or be in the office) for these pages; without it they show a "connect to the VPN" message.
# `npm run dev` copies them from ../zamil-attendance/.env on first run. See ../EBS-CONNECTIVITY.md
# for the plan once the app runs on the internet.
EBS_ENABLED=true
EBS_DB_HOST=
EBS_DB_PORT=1521
EBS_DB_SID=
EBS_DB_USERNAME=
EBS_DB_PASSWORD=
EBS_DB_CONNECT_TIMEOUT=10
# Optional: a full connect descriptor instead of host/port/SID
EBS_CONNECT_STRING=
# ebs = read the EBS database (VPN, as CI3); adw = read ADW copies of the EBS tables
# (Option B in ../EBS-CONNECTIVITY.md, once the copy job and tables exist)
EBS_SOURCE=ebs

# --- Zamil Digitalization single sign-on ------------------------------------
ZAMIL_AUTH_API_BASE_URL=http://127.0.0.1:7381/api/v1
# zr_session when the Zamil server runs with APP_ENV=test, __Host-zr_session otherwise
ZAMIL_AUTH_SESSION_COOKIE_NAME=zr_session
ZAMIL_AUTH_COOKIE_SECURE=false
ZAMIL_AUTH_COOKIE_SAMESITE=lax
# Zamil login page for separate-origin deployments (blank: local dev maps port 7388 to 7382)
VITE_ZAMIL_LOGIN_URL=
