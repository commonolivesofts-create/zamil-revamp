{
  "name": "expensehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ExpenseHub — employee expense claims for Zamil Plastic Industries (IPP, FPP, APP)",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @expensehub/api\" \"npm run dev -w @expensehub/web\"",
    "build": "npm run build -w @expensehub/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run e2e -w @expensehub/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "data:reset": "tsx db/scripts/data-reset.ts",
    "db:ping": "tsx db/scripts/db-ping.ts",
    "fusion:bip-check": "tsx apps/api/src/integrations/fusion/live/bip-check.ts",
    "docs:bip": "node scripts/build-bip-guide.mjs",
    "fusion:bip-deploy": "node scripts/bip-deploy.mjs",
    "samples": "tsx apps/api/src/receipts/testing/make-samples.ts",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.0.0",
    "archiver": "^7.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  }
}
